{
  "name": "heading-word-count",
  "version": "1.0.0",
  "description": "Obsidian plugin: per-heading (H1–H6) word count outline with CJK + English support.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production"
  },
  "keywords": ["obsidian", "word-count", "outline", "cjk", "chinese"],
  "author": "Cem Yang",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.20.0",
    "obsidian": "latest",
    "tslib": "^2.6.2",
    "typescript": "^5.3.3"
  }
}
